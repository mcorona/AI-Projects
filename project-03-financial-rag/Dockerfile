# Serves app.py (the Streamlit dashboard) only -- not indexing, not
# evaluation. Uses requirements-app.txt, a subset of requirements.txt, so
# the image doesn't ship Jupyter, matplotlib, rank-bm25 or pytest.
FROM python:3.12-slim

WORKDIR /app

COPY requirements-app.txt .
RUN pip install --no-cache-dir -r requirements-app.txt

COPY src/ src/
COPY app.py .
COPY output/reports/ output/reports/

EXPOSE 8501

# The corpus and the 169 MB embedding matrix are gitignored and regenerated by
# `python -m src.evaluation.run_retrieval_eval`. Mount them, and pass
# credentials as an environment variable rather than baking them in:
#
#   docker build -t financial-rag .
#   docker run -p 8501:8501 \
#     -e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
#     -v "$(pwd)/data:/app/data" \
#     financial-rag
#
# Without -e the dashboard still serves both benchmark tabs and live
# retrieval; only answer generation is disabled.
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
