# Serves app.py (the Streamlit dashboard) only -- not training, not
# evaluation. Uses requirements-app.txt, a subset of requirements.txt, so
# the image ships neither scikit-image, timm, Jupyter nor pytest.
FROM python:3.12-slim

WORKDIR /app

# libgl / libglib are what Pillow and torchvision's image codecs link
# against; the slim base image does not carry them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-app.txt .
RUN pip install --no-cache-dir -r requirements-app.txt

COPY src/ src/
COPY app.py .
COPY output/reports/ output/reports/

EXPOSE 8501

# The fine-tuned checkpoint (~95 MB) is gitignored and regenerated by
# `python -m src.models.run_training --stage finetune`. Mount it rather
# than baking it in:
#
#   docker build -t pet-breeds .
#   docker run -p 8501:8501 \
#     -v "$(pwd)/output/models:/app/output/models" \
#     pet-breeds
#
# Without the mount the Results and ImageNet tabs still work -- they read
# the committed JSON reports; only the Classify tab needs the checkpoint.
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
