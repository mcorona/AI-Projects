# Serves app.py (Streamlit dashboard) only -- not training. Uses
# requirements-dashboard.txt (a minimal subset of requirements.txt) so the
# image doesn't ship TensorFlow, Prophet, statsmodels, Jupyter, etc.: the
# dashboard only reads precomputed parquet/JSON artifacts, it never
# retrains a model.
FROM python:3.11-slim

WORKDIR /app

COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt

COPY src/ src/
COPY app.py .

EXPOSE 8501

# No data or model artifacts are baked into the image -- they're gitignored
# and regenerated by running notebooks 01-03. Mount them at runtime:
#
#   docker build -t reliance-forecast-dashboard .
#   docker run -p 8501:8501 \
#     -v "$(pwd)/data/processed:/app/data/processed" \
#     -v "$(pwd)/output/reports:/app/output/reports" \
#     reliance-forecast-dashboard
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
